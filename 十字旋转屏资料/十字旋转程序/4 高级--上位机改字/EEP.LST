  84          
  85          /* 打开 ISP,IAP 功能 */
  86          void ISP_IAP_enable(void)
  87          {
  88   1        EA  = 0;  /* 关中断 */
  89   1        ISP_CONTR = ISP_CONTR & 0x18;       /* 0001,1000 */
  90   1        ISP_CONTR = ISP_CONTR | WAIT_TIME;
  91   1        ISP_CONTR = ISP_CONTR | 0x80;       /* 1000,0000 */
  92   1      }
  93          
  94          /* 关闭 ISP,IAP 功能 */
  95          void ISP_IAP_disable(void)
  96          {
  97   1        ISP_CONTR = ISP_CONTR & 0x7f; /* 0111,1111 */
  98   1        ISP_TRIG  = 0x00;
  99   1        EA      =   1;                  /* 开中断 */
 100   1      }
 101          
 102          /* 字节读 */
 103          INT8U byte_read(INT16U byte_addr)
 104          {
 105   1        ISP_ADDRH = (INT8U)(byte_addr >> 8);
 106   1        ISP_ADDRL = (INT8U)(byte_addr & 0x00ff);
 107   1      
 108   1        ISP_CMD   = ISP_CMD & 0xf8;        /* 1111,1000 */
 109   1        ISP_CMD   = ISP_CMD | READ_AP_and_Data_Memory_Command;        /* 0000,0001 */
 110   1      
 111   1        ISP_IAP_enable();
 112   1      
 113   1        ISP_TRIG  = 0x46;
 114   1        ISP_TRIG  = 0xb9;
 115   1        _nop_();
 116   1      
 117   1        ISP_IAP_disable();
C51 COMPILER V9.52.0.0   EEP                                                               08/06/2015 13:31:28 PAGE 3   

 118   1        return (ISP_DATA);
 119   1      }
 120          
 121          /* 扇区擦除 */
 122          INT8U sector_erase(INT16U sector_addr)
 123          {
 124   1        INT16U get_sector_addr  = 0;
 125   1        get_sector_addr     = (sector_addr & 0xfe00); /* 1111,1110,0000,0000; 取扇区地址 */
 126   1        ISP_ADDRH           = (INT8U)(get_sector_addr >> 8);
 127   1        ISP_ADDRL           = 0x00;
 128   1      
 129   1        ISP_CMD = ISP_CMD & 0xf8; /* 1111,1000 */
 130   1        ISP_CMD = ISP_CMD | SECTOR_ERASE_AP_and_Data_Memory_Command;  /* 0000,0011 */
 131   1      
 132   1        ISP_IAP_enable();
 133   1        ISP_TRIG  = 0x46;        /* 触发ISP_IAP命令 */
 134   1        ISP_TRIG  = 0xb9;        /* 触发ISP_IAP命令 */
 135   1         _nop_();
 136   1      
 137   1        ISP_IAP_disable();
 138   1        return OK;
 139   1      }
 140          
 141          /* 字节编程 */
 142          INT8U byte_program(INT16U byte_addr, INT8U original_data)
 143          {
 144   1        ISP_ADDRH = (INT8U)(byte_addr >> 8);
 145   1        ISP_ADDRL = (INT8U)(byte_addr & 0x00ff);
 146   1      
 147   1        ISP_CMD   = ISP_CMD & 0xf8;        /* 1111,1000 */
 148   1        ISP_CMD   = ISP_CMD | PROGRAM_AP_and_Data_Memory_Command;   /* 0000,0010 */
 149   1        ISP_DATA  = original_data;
 150   1      
 151   1        ISP_IAP_enable();
 152   1        ISP_TRIG  = 0x46;        /* 触发ISP_IAP命令 */
 153   1        ISP_TRIG  = 0xb9;        /* 触发ISP_IAP命令 */
 154   1        _nop_();
 155   1      
 156   1        ISP_IAP_disable();
 157   1        return  OK;
 158   1      }


